<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net472 because that is what the game's mono runtime loads. Like the other four
      .Client projects this is an EDITING SURFACE: it builds on its own so the panel can
      be compiled in isolation, but what ships is Casino.Client, which compiles these
      files in. Do not install the DLL this produces.
    -->
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>Farkle.Client</RootNamespace>
    <AssemblyName>Farkle.Client</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.1.0</Version>

    <SPTPath Condition="'$(SPTPath)' == ''">H:\SPT4.1.X</SPTPath>
    <SPTPath Condition="'$(SPTPath)' != ''">$(SPTPath.TrimEnd('\'))</SPTPath>
    <GameManaged>$(SPTPath)\EscapeFromTarkov_Data\Managed</GameManaged>
    <SptPlugins>$(SPTPath)\BepInEx\plugins\spt</SptPlugins>
    <BepInExCore>$(SPTPath)\BepInEx\core</BepInExCore>

    <AssemblySearchPaths>$(GameManaged);$(AssemblySearchPaths)</AssemblySearchPaths>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>

  <Target Name="ValidateSPTPath" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(GameManaged)\Assembly-CSharp.dll')"
           Text="SPTPath ('$(SPTPath)') is not an SPT install root -- no EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll." />
    <Error Condition="!Exists('$(SptPlugins)\spt-common.dll')"
           Text="No spt-common.dll under '$(SptPlugins)'. The plugin must be built against the install it will run on." />
  </Target>

  <ItemGroup>
    <!-- One copy of what every table draws with. See the root CLAUDE.md. -->
    <Compile Include="..\Casino.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(GameManaged)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManaged)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>$(SptPlugins)\spt-common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>$(SptPlugins)\spt-reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
